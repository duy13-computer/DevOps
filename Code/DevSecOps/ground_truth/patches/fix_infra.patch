diff --git a/Code/DevSecOps/infra/main.tf b/Code/DevSecOps/infra/main.tf
--- a/Code/DevSecOps/infra/main.tf
+++ b/Code/DevSecOps/infra/main.tf
@@ -30,27 +30,27 @@
 
 resource "aws_security_group" "lab" {
   name        = "devsecops-seeded-lab"
-  description = "Intentionally insecure scanner fixture; do not apply."
+  description = "Restricted management access for the isolated lab."
   vpc_id      = aws_vpc.lab.id
 
   #checkov:skip=CKV2_AWS_5: This scanner-only lab exports the group for external test workloads and does not create compute resources.
 
-  # SEEDED-IAC-01: SSH is exposed to every IPv4 address.
+  # Management access is limited to the configured private CIDR.
   ingress {
-    description = "SEEDED-IAC-01: public SSH"
+    description = "SSH from the approved management network"
     from_port   = 22
     to_port     = 22
     protocol    = "tcp"
-    cidr_blocks = ["0.0.0.0/0"]
-  }
-
-  # SEEDED-IAC-02: RDP is exposed to every IPv4 address.
+    cidr_blocks = [var.management_cidr]
+  }
+
+  # RDP is limited to the configured private CIDR.
   ingress {
-    description = "SEEDED-IAC-02: public RDP"
+    description = "RDP from the approved management network"
     from_port   = 3389
     to_port     = 3389
     protocol    = "tcp"
-    cidr_blocks = ["0.0.0.0/0"]
+    cidr_blocks = [var.management_cidr]
   }
 
   egress = []
@@ -58,8 +58,6 @@
 
 # This disposable single-region lab has no cross-region recovery or event-driven
 # consumer. The bucket is versioned, encrypted, and has a bounded retention period.
-# SEEDED-IAC-03: server-side encryption is not configured.
-# SEEDED-IAC-04: a public-read ACL is attached.
 resource "aws_s3_bucket" "lab" {
   bucket_prefix = var.bucket_prefix
   force_destroy = true
@@ -90,6 +88,17 @@
   target_key_id = aws_kms_key.lab_s3.key_id
 }
 
+resource "aws_s3_bucket_server_side_encryption_configuration" "lab" {
+  bucket = aws_s3_bucket.lab.id
+  rule {
+    apply_server_side_encryption_by_default {
+      sse_algorithm     = "aws:kms"
+      kms_master_key_id = aws_kms_key.lab_s3.arn
+    }
+    bucket_key_enabled = true
+  }
+}
+
 resource "aws_s3_bucket_ownership_controls" "lab" {
   bucket = aws_s3_bucket.lab.id
   rule {
@@ -99,19 +108,10 @@
 
 resource "aws_s3_bucket_public_access_block" "lab" {
   bucket                  = aws_s3_bucket.lab.id
-  block_public_acls       = false
-  block_public_policy     = false
-  ignore_public_acls      = false
-  restrict_public_buckets = false
-}
-
-resource "aws_s3_bucket_acl" "lab" {
-  depends_on = [
-    aws_s3_bucket_ownership_controls.lab,
-    aws_s3_bucket_public_access_block.lab,
-  ]
-  bucket = aws_s3_bucket.lab.id
-  acl    = "public-read"
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
 }
 
 resource "aws_s3_bucket_versioning" "lab" {
@@ -241,21 +241,28 @@
   })
 }
 
-# SEEDED-IAC-05: AdministratorAccess is broader than the lab requires.
-resource "aws_iam_role_policy_attachment" "lab_admin" {
-  role       = aws_iam_role.lab.name
-  policy_arn = "arn:aws:iam::aws:policy/AdministratorAccess"
+resource "aws_iam_role_policy" "lab_runtime" {
+  name = "devsecops-lab-runtime"
+  role = aws_iam_role.lab.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect   = "Allow"
+      Action   = ["logs:CreateLogStream", "logs:PutLogEvents"]
+      Resource = "arn:aws:logs:${var.aws_region}:*:log-group:/devsecops/lab:*"
+    }]
+  })
 }
 
 resource "aws_ecr_repository" "lab" {
   name                 = var.ecr_repository_name
-  image_tag_mutability = "MUTABLE"
+  image_tag_mutability = "IMMUTABLE"
   encryption_configuration {
     encryption_type = "KMS"
     kms_key         = aws_kms_key.ecr.arn
   }
   image_scanning_configuration {
-    scan_on_push = false
+    scan_on_push = true
   }
 }
 
diff --git a/Code/DevSecOps/infra/variables.tf b/Code/DevSecOps/infra/variables.tf
--- a/Code/DevSecOps/infra/variables.tf
+++ b/Code/DevSecOps/infra/variables.tf
@@ -4,6 +4,11 @@
   default     = "us-east-1"
 }
 
+variable "management_cidr" {
+  description = "Private CIDR permitted to reach the lab management ports."
+  type        = string
+  default     = "10.20.0.0/16"
+}
 
 variable "bucket_prefix" {
   description = "Globally unique prefix for the deliberately weak demo bucket."
